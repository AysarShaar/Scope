# SCOPE MEDIA Platform Environment Variables

# APP_URL: The base URL of the website (e.g. "https://scope-media.com" or "http://localhost:3000")
APP_URL="http://localhost:3000"


# Cloudinary: legacy images only. New uploads go to R2 (binding IMAGES in wrangler.jsonc);
# Cloudinary is used for uploads only when that binding is missing.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="scope_articles_preset"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# NextAuth & Google OAuth Credentials
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-random-32-character-secret-here"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# (Optional) Comma-separated list of emails with full Administrator privileges:
ADMIN_EMAILS="editor@scope-media.com"
