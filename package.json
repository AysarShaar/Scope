{
  "name": "scope-media-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:pull": "node scripts/pull-db.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "start": "next start",
    "lint": "eslint .",
    "clean": "rm -rf .next",
    "test": "vitest run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.21",
    "browser-image-compression": "^2.0.2",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-simple-maps": "^5.0.5",
    "sanitize-html": "^2.18.0",
    "@tailwindcss/postcss": "4.1.11",
    "tailwindcss": "4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@next/eslint-plugin-next": "^16.3.8",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@types/react-simple-maps": "^3.0.6",
    "@typescript-eslint/parser": "^8.71.0",
    "drizzle-kit": "^0.18.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.147.0"
  },
  "optionalDependencies": {
    "@emnapi/runtime": "1.11.3",
    "@img/sharp-wasm32": "0.35.5",
    "@tailwindcss/oxide-android-arm64": "4.1.11",
    "@tailwindcss/oxide-win32-x64-msvc": "4.1.11",
    "lightningcss-android-arm64": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.30.1"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "allowScripts": {
    "aws4fetch@1.0.20": true,
    "ci-info@4.4.0": true,
    "es5-ext@0.10.64": true,
    "foreground-child@3.3.1": true,
    "jackspeak@4.2.3": true,
    "package-json-from-dist@1.0.1": true,
    "path-scurry@2.0.2": true,
    "path-to-regexp@6.3.0": true,
    "tinyexec@0.3.2": true,
    "yargs@18.2.0": true,
    "@tailwindcss/oxide": true,
    "esbuild@0.25.4": true
  }
}
